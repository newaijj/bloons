# Compiled binaries. Rebuild: cd tracker && swiftc -O Sources/*.swift -o tracker
/tracker/tracker
/probe/probe
/calibrate/calibrate

# Frame captures, ~4MB each and regenerated by any calibrate run.
# The paired OCR .txt dumps are small and kept.
/calibrate/out/*.png

# Tracker session frames, for the same reason as calibrate's: ~2-4MB each, and
# one match is ~1100 of them. The interpretable part of a session -- its
# manifest.json, truth.jsonl and notes.txt -- is a few KB and IS tracked, so a
# session stays scoreable from the repo while the pixels live on disk only.
# Back the frames up outside git; nothing here regenerates them.
/tracker/out/**/*.png

# Run artifacts
/tracker/run.out

.DS_Store

# Learned tower prices. Machine-generated, grows across matches, and specific
# to your resolution — rebuild it by playing rather than sharing it.
/tracker/sprites.json
